{$PUBLIC_HOST} {
  encode zstd gzip
  request_body {
    max_size 1MB
  }
  header {
    -Server
    Referrer-Policy no-referrer
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    X-Robots-Tag "noindex, nofollow"
    Strict-Transport-Security "max-age=15552000"
  }
  reverse_proxy web:3001
}
