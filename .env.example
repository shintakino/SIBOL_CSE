# Development only. Copy to .env and replace the auth secret before starting.
POSTGRES_USER=sibol
POSTGRES_PASSWORD=sibol-local-only
POSTGRES_DB=sibol
DATABASE_URL=postgresql://sibol:sibol-local-only@localhost:55439/sibol
# Per API process; budget total PostgreSQL connections across all replicas.
DB_POOL_MAX=10
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
API_INTERNAL_URL=http://localhost:3000
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Sibol <no-reply@example.test>

# Release/operations only. Supply real values in a private environment file.
PUBLIC_HOST=review.example.com
APP_DATABASE_URL=postgresql://sibol:replace-with-url-encoded-password@postgres:5432/sibol
BACKUP_DIRECTORY=./.cache/backups
BACKUP_AGE_RECIPIENT=replace-with-public-age-recipient
# Keep the private key offline; mount it only for a controlled restore.
BACKUP_IDENTITY_FILE=./.cache/backup-identity
RESTORE_DATABASE=sibol_restore
BACKUP_FILE=
